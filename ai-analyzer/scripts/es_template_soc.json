{
  "index_patterns": ["soc-*"],
  "priority": 100,
  "template": {
    "settings": {
      "index": {
        "number_of_replicas": 0,
        "codec": "best_compression"
      }
    },
    "mappings": {
      "dynamic": true,
      "properties": {
        "@timestamp": { "type": "date" },
        "source": {
          "properties": {
            "ip": { "type": "ip" },
            "port": { "type": "long" }
          }
        },
        "destination": {
          "properties": {
            "ip": { "type": "ip" },
            "port": { "type": "long" }
          }
        },
        "network": {
          "properties": {
            "community_id": { "type": "keyword" }
          }
        },
        "event": {
          "properties": {
            "dataset": { "type": "keyword" },
            "kind": { "type": "keyword" }
          }
        },
        "observer": {
          "properties": {
            "type": { "type": "keyword" }
          }
        },
        "suricata": {
          "properties": {
            "eve": {
              "properties": {
                "event_type": { "type": "keyword" },
                "alert": {
                  "properties": {
                    "signature": { "type": "text", "norms": false },
                    "signature_id": { "type": "long" },
                    "gid": { "type": "long" },
                    "rev": { "type": "long" },
                    "severity": { "type": "long" },
                    "category": { "type": "keyword" },
                    "action": { "type": "keyword" }
                  }
                }
              }
            }
          }
        },
        "has_ai_analysis": { "type": "boolean" },
        "ai_doc_id": { "type": "keyword" }
      },
      "dynamic_templates": [
        {
          "searchable_url_text": {
            "match_mapping_type": "string",
            "path_match": "url.*",
            "mapping": {
              "type": "text",
              "norms": false,
              "index_options": "docs",
              "fields": {
                "keyword": { "type": "keyword", "ignore_above": 1024 }
              }
            }
          }
        },
        {
          "searchable_user_agent": {
            "match_mapping_type": "string",
            "path_match": "user_agent.*",
            "mapping": {
              "type": "text",
              "norms": false,
              "index_options": "docs",
              "fields": {
                "keyword": { "type": "keyword", "ignore_above": 1024 }
              }
            }
          }
        },
        {
          "searchable_suricata_http": {
            "match_mapping_type": "string",
            "path_match": "suricata.eve.http.*",
            "mapping": {
              "type": "text",
              "norms": false,
              "index_options": "docs",
              "fields": {
                "keyword": { "type": "keyword", "ignore_above": 1024 }
              }
            }
          }
        },
        {
          "searchable_payload": {
            "match_mapping_type": "string",
            "path_match": "suricata.eve.payload_printable",
            "mapping": {
              "type": "text",
              "norms": false,
              "index_options": "docs",
              "fields": {
                "keyword": { "type": "keyword", "ignore_above": 1024 }
              }
            }
          }
        },
        {
          "searchable_dns": {
            "match_mapping_type": "string",
            "path_match": "suricata.eve.dns.queries.*",
            "mapping": {
              "type": "keyword"
            }
          }
        },
        {
          "searchable_tls": {
            "match_mapping_type": "string",
            "path_match": "suricata.eve.tls.*",
            "mapping": {
              "type": "keyword"
            }
          }
        },
        {
          "searchable_files": {
            "match_mapping_type": "string",
            "path_match": "suricata.eve.files.*",
            "mapping": {
              "type": "keyword"
            }
          }
        },
        {
          "searchable_zeek_http": {
            "match_mapping_type": "string",
            "path_match": "zeek.http.*",
            "mapping": {
              "type": "text",
              "norms": false,
              "fields": {
                "keyword": { "type": "keyword", "ignore_above": 1024 }
              }
            }
          }
        },
        {
          "searchable_meta": {
            "match_mapping_type": "string",
            "path_match": "event.*",
            "mapping": {
              "type": "keyword"
            }
          }
        },
        {
          "searchable_soc": {
            "match_mapping_type": "string",
            "path_match": "soc.*",
            "mapping": {
              "type": "keyword"
            }
          }
        },
        {
          "searchable_network": {
            "match_mapping_type": "string",
            "path_match": "network.*",
            "mapping": {
              "type": "keyword"
            }
          }
        },
        {
          "no_index_string": {
            "match_mapping_type": "string",
            "mapping": {
              "type": "keyword",
              "index": false,
              "doc_values": false
            }
          }
        },
        {
          "no_index_long": {
            "match_mapping_type": "long",
            "mapping": {
              "type": "long",
              "index": false,
              "doc_values": false
            }
          }
        },
        {
          "no_index_double": {
            "match_mapping_type": "double",
            "mapping": {
              "type": "double",
              "index": false,
              "doc_values": false
            }
          }
        },
        {
          "no_index_boolean": {
            "match_mapping_type": "boolean",
            "mapping": {
              "type": "boolean",
              "index": false,
              "doc_values": false
            }
          }
        },
        {
          "no_index_date": {
            "match_mapping_type": "date",
            "mapping": {
              "type": "date",
              "index": false,
              "doc_values": false
            }
          }
        }
      ]
    }
  }
}
