alert http any any -> any any (msg:"path traversal：URI 目录穿越读取 .bash_history 敏感文件"; flow:established,to_server; http.uri; content:"../"; content:".bash_history"; nocase; fast_pattern; classtype:web-application-attack; sid:91226; rev:1;)
