alert http any any -> any any (msg:"path traversal：URI 目录穿越读取 proc/self/environ 敏感文件"; flow:established,to_server; http.uri; content:"../"; content:"proc/self/environ"; nocase; fast_pattern; classtype:web-application-attack; sid:91221; rev:1;)
alert http any any -> any any (msg:"path traversal：URI 目录穿越读取 proc/self/cmdline 敏感文件"; flow:established,to_server; http.uri; content:"../"; content:"proc/self/cmdline"; nocase; fast_pattern; classtype:web-application-attack; sid:91222; rev:1;)
