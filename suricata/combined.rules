alert http any any -> any any (msg:"path traversal：URI 目录穿越读取 etc/group 敏感文件"; flow:established,to_server; http.uri; content:"../"; content:"etc/group"; nocase; fast_pattern; classtype:web-application-attack; sid:91217; rev:1;)
alert http any any -> any any (msg:"path traversal：URI 目录穿越读取 etc/master.passwd 敏感文件"; flow:established,to_server; http.uri; content:"../"; content:"etc/master.passwd"; nocase; fast_pattern; classtype:web-application-attack; sid:91218; rev:1;)
