alert http any any -> any any (msg:"path traversal：URI 目录穿越读取 boot.ini"; flow:established,to_server; http.uri; content:"../"; content:"boot.ini"; nocase; fast_pattern; classtype:web-application-attack; sid:91230; rev:1;)
